# Network Traffic Analysis & Threat Hunting Configuration

# Flask application secret key
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# SQLite database path (use persistent disk path if deploying to cloud containers, e.g. /var/data/network_traffic.db)
DATABASE_PATH=network_traffic.db

# Ingestion API Key (required by agent/capture_agent.py to stream packets securely to Render)
INGESTION_KEY=generate-a-strong-secret-token-for-remote-agent

# Network interface for local Scapy sniffing (leave empty for auto-detection)
CAPTURE_INTERFACE=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional custom path to tshark executable if pyshark is used
TSHARK_PATH=

# Database batch processing settings
DB_BATCH_SIZE=1
DB_BATCH_INTERVAL=2.0

# Database retention policy (days to keep old packets)
RETENTION_DAYS=30

# Web server port (automatically assigned by Render/Heroku via $PORT)
PORT=5000
